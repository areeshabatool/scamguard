# Copy to .env and fill in locally. Never commit .env.
#
# Claude is the default backend. Set ONE of the keys below.
# .env is loaded automatically by the CLI, the web API and the eval runners.

# Default backend (Anthropic Claude):
ANTHROPIC_API_KEY=

# Optional OpenAI backend (GPT-4o-mini). If you set this and leave ANTHROPIC_API_KEY
# empty, the OpenAI backend is used automatically.
OPENAI_API_KEY=

# Optional: force a backend regardless of which keys are set ("openai" or "anthropic").
# SCAMGUARD_LLM=openai
